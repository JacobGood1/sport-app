(ns sports-app.landing-page
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [sports-app.athlete-profile-form :as athlete-form]
            [sports-app.recruiter-profile-form :as recruiter-form]
            [sports-app.rive-utils :as utils]
            [sports-app.theme :refer [blue red black white orange green purple grey light-grey dark-grey]]))

;; Menu item component with hover effect
(defn menu-item [label]
  (let [item-width (+ 40.0 (* (count label) 7.0))]
    ; Calculate fixed width based on text length
    (f/widget
     :let [is-hovered (atom false)]
     :watch [hovered is-hovered]
     (m/MouseRegion
      .onEnter (fn [_] (reset! is-hovered true) nil)
      .onExit (fn [_] (reset! is-hovered false) nil)
      .child
      (m/Container
       .padding (m/EdgeInsets.symmetric .vertical 15 .horizontal 0)
       .width item-width ; Fixed width that doesn't change with hover state
       .child
       (m/Stack
        .alignment m.Alignment/center
        .children
        [(m/AnimatedContainer
          .duration (Duration .milliseconds 300)
          .curve m.Curves/easeOutCubic
          .width item-width ; Fixed width that doesn't change
          .height (if hovered 40.0 0.0) ; Only height animates
          .decoration (m/BoxDecoration
                       .color dark-grey
                       .borderRadius (m/BorderRadius.circular 5.0)))
         (m/Padding
          .padding (m/EdgeInsets.symmetric .horizontal 0)
          .child
          (m/Text label
                 .style (m/TextStyle
                         .color white
                         .fontSize 20.0
                         .fontWeight (if hovered m.FontWeight/bold m.FontWeight/normal))))]))))))

;; Navigation menu for the landing page
(defn navigation-menu []
  (m/Container
   .padding (m/EdgeInsets.symmetric .horizontal 20.0)
   .height 70.0
   ;.decoration (m/BoxDecoration
   ;             .color (m/Colors.grey.withOpacity 0.2)
   ;             .boxShadow [(m/BoxShadow
   ;                          .color (m/Colors.grey.withOpacity 0.3)
   ;                          .spreadRadius 1.0
   ;                          .blurRadius 5.0
   ;                          .offset (m/Offset 0 3))])
   .child
   (m/Row
    .mainAxisAlignment m.MainAxisAlignment/start
    .children
    [(m/Container
      .padding (m/EdgeInsets.only .right 10.0)
      .child
      (m/Row
       .children
       [(m/Container
         .width 120.0
         .height 40.0
         .decoration (m/BoxDecoration
                      .color red
                      .borderRadius (m/BorderRadius.circular 5.0))
         .child (m/Center
                 .child (m/Text "NXT ERA"
                              .style (m/TextStyle
                                      .color white
                                      .fontSize 18.0
                                      .fontWeight m.FontWeight/bold))))]))
     (m/Row
      .children
      [(menu-item "Athletes")
       (menu-item "Employers")
       (menu-item "Company")])])))



