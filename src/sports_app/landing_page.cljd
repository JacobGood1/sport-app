          .height 60.0
          .decoration (m/BoxDecoration
                       .shape m.BoxShape/circle
                       .color blue)
          .child (m/Center
                  .child (m/Text "3"
                                .style (m/TextStyle
                                        .color white
                                        .fontSize 24.0
                                        .fontWeight m.FontWeight/bold))))
         (m/SizedBox .height 10.0)
         (m/Text "Launch Career"
                .style (m/TextStyle
                        .fontWeight m.FontWeight/bold))
         (m/SizedBox .height 5.0)
         (m/Container
          .width 100.0
          .child (m/Text "Start your professional journey with confidence"
