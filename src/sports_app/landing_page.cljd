          .width 60.0
          .height 60.0
          .decoration (m/BoxDecoration
                       .shape m.BoxShape/circle
                       .color green)
          .child (m/Icon (m/Icons.work)
                        .color white
                        .size 30.0))
         (m/SizedBox .height 10.0)
         (m/Text "Career-Ready Focus"
                .style (m/TextStyle
                        .fontWeight m.FontWeight/bold))])

       (m/Column
        .children
        [(m/Container
          .width 60.0
          .height 60.0
