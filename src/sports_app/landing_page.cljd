                        .size 30.0))
         (m/SizedBox .height 10.0)
         (m/Text "Top Recruiter Access"
                .style (m/TextStyle
                        .fontWeight m.FontWeight/bold))])])])))

(defn social-proof-section []
  (m/Container
   .padding (m/EdgeInsets.symmetric .vertical 20.0 .horizontal 16.0)
   .child
   (m/Column
    .crossAxisAlignment m.CrossAxisAlignment/center
    .children
    [(m/Text "Trusted By"
            .style (m/TextStyle
                    .fontSize 24.0
                    .fontWeight m.FontWeight/bold))
     (m/SizedBox .height 20.0)
     (m/Row
      .mainAxisAlignment m.MainAxisAlignment/spaceEvenly
      .children
      [(m/Container
        .width 80.0
        .height 40.0
        .decoration (m/BoxDecoration
                     .color grey
                     .borderRadius (m/BorderRadius.circular 5.0))
        .child (m/Center
                .child (m/Text "LOGO")))
       (utils/make-rive-widget 1000
                               1000
                               "rocket-ship"
                               "Artboard"
                               "State Machine 1"
                               :with-state-machine (fn [sm] (println "gell") (println sm)))

       (m/Container
        .width 80.0
        .height 40.0
        .decoration (m/BoxDecoration
                     .color grey
                     .borderRadius (m/BorderRadius.circular 5.0))
        .child (m/Center
                .child (m/Text "LOGO")))

       (m/Container
        .width 80.0
        .height 40.0
        .decoration (m/BoxDecoration
                     .color grey
                     .borderRadius (m/BorderRadius.circular 5.0))
        .child (m/Center
                .child (m/Text "LOGO")))])

     (m/SizedBox .height 20.0)
     (m/Container
      .padding (m/EdgeInsets.all 16.0)
      .decoration (m/BoxDecoration
                   .color grey
                   .borderRadius (m/BorderRadius.circular 8.0))
      .child (m/Column
              .children
              [(m/Text "\"NXT ERA helped me transition from college sports to a fulfilling career.\""
                      .textAlign m.TextAlign/center
                      .style (m/TextStyle
                              .fontStyle m.FontStyle/italic))
               (m/SizedBox .height 10.0)
               (m/Text "- Student Athlete"
                      .textAlign m.TextAlign/center
                      .style (m/TextStyle
                              .fontWeight m.FontWeight/bold))]))])))

(defn landing-page
  [ctx]
  (f/widget
   :context ctx
   (m/Scaffold
    .appBar (m/AppBar .backgroundColor black
                      .title (m/Container .child (navigation-menu)))
    .body
    (m/SingleChildScrollView
     .child
     (m/Column
      .crossAxisAlignment m.CrossAxisAlignment/center
      .children
      [(m/Container
        .height 500.0
        .width double/infinity
        .decoration (m/BoxDecoration
                     .color dark-grey)
        .padding (m/EdgeInsets.all 20.0)
        .child
        (m/Column
         .mainAxisAlignment m.MainAxisAlignment/center
         .children
         [(m/Text "Bridging Student-Athletes and Employers"
                 .textAlign m.TextAlign/center
                 .style (m/TextStyle
                         .fontSize 32.0
                         .fontWeight m.FontWeight/bold
                         .color white))
          (m/SizedBox .height 20.0)
          (m/Text "Create a profile or connect with top-tier early-career talent."
                 .textAlign m.TextAlign/center
                 .style (m/TextStyle
                         .fontSize 18.0
                         .color white))
          (m/SizedBox .height 40.0)
          (m/Row
           .mainAxisAlignment m.MainAxisAlignment/center
           .children
           [(m/ElevatedButton
             .style (m/ElevatedButton.styleFrom
                     .backgroundColor blue
                     .padding (m/EdgeInsets.symmetric .vertical 15.0 .horizontal 30.0))
             .onPressed (fn []
                          (.push m/Navigator ctx (m/MaterialPageRoute .builder (fn [_] (athlete-form/athlete-profile-form ctx))))
                          nil)
             .child (m/Text "I'm a Student-Athlete"
                           .style (m/TextStyle
                                   .fontSize 16.0)))
            (m/SizedBox .width 20.0)
            (m/ElevatedButton
             .style (m/ElevatedButton.styleFrom
                     .backgroundColor orange
                     .padding (m/EdgeInsets.symmetric .vertical 15.0 .horizontal 30.0))
             .onPressed (fn []
                          (.push m/Navigator ctx (m/MaterialPageRoute .builder (fn [_] (recruiter-form/recruiter-profile-form ctx))))
                          nil)
             .child (m/Text "I'm a Recruiter"
                           .style (m/TextStyle
                                   .fontSize 16.0)))])]))

       (how-it-works-section)
       (why-nxt-era-section)
       (social-proof-section)])))))

;; Main function moved to main.cljd
;; This function can be used for standalone testing of the landing page
(comment
  (defn main []
    (m/runApp
     (m/MaterialApp
      .title "NXT ERA"
      .theme (m/ThemeData
              .primarySwatch blue
              .visualDensity m.VisualDensity/adaptivePlatformDensity)
      .home (landing-page nil)))))
