(ns sports-app.main
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [sports-app.rocket-ship :as rs]
            [sports-app.rive-utils :as rutils]
            ["package:rive/rive.dart" :as rive]))


(defn main []
  ;; trigger 1
  (let [controller (rive/SimpleAnimation "idle")
        rive-widget (rutils/->RiveWidget)]
    (f/run
      (m/MaterialApp
        .title "Welcome to Flutter"
        .theme (m/ThemeData .primarySwatch m.Colors/pink))
      .home
      (m/Scaffold
        .appBar (m/AppBar
                  .title (m/Text "Welcome to ClojureDart")))
      .body
      m/Center
      (m/Column
        .mainAxisAlignment m.MainAxisAlignment/center
        .children
        [
         (do
           (println (rs/rocket-ship))
           (println (rutils/->RiveWidget))
           (m/Text "kanban can when?!"
                  .style (m/TextStyle
                           .color m.Colors/red
                           .fontSize 32.0)))
         (m/SizedBox .height 20.0)
         (f/widget
           :let [button-state (atom (m/Icon (m/Icons.flight_takeoff)))]
           :watch [icon-symbol button-state
                   rocket-ship-atr (rs/rocket-ship)]

           (m/ElevatedButton.icon
             .onPressed (fn [] (println (rutils/artboard rive-widget)))

                          ;(do (println (:state-machine-controller rocket-ship-atr))
                          ;    (rs/handle-rocket-ship controller button-state)))
             ; Icon(isPlaying ? Icons.flight_land : Icons.flight_takeoff )
             .icon icon-symbol
             .label (m/Text "dsadsa")))]))))
