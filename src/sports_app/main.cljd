(ns sports-app.main
  (:require ["package:flutter/material.dart" :as m]
            [cljd.flutter :as f]
            [sports-app.rive-utils :as utils]
            [sports-app.rocket-ship :as rs]
            [sports-app.rive-utils :as rutils]
            [sports-app.landing-page :as landing]
            ["package:rive_native/rive_native.dart" :as rive]
            [sports-app.theme :refer [black]]))


(defn main []
  (await (utils/init-rive))
  (f/run
    (m/MaterialApp
      .title "NXT ERA"
      .theme (m/ThemeData
              .primarySwatch m.Colors/red
              .primaryColor black
              ;.appBarTheme (m/AppBarTheme .color black)
              .visualDensity m.VisualDensity/adaptivePlatformDensity)
      .home (landing/landing-page nil))))

(comment (m/Slider
              .value 0
              .min 0
              .max 100
              .onChanged (fn [a] 
                           nil)))


